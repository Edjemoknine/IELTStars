generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TestType {
  ACADEMIC
  GENERAL_TRAINING
}

enum IELTSModule {
  READING
  LISTENING
  WRITING
  SPEAKING
}

enum TestStatus {
  DRAFT
  PUBLISHED
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE_NOT_GIVEN
  YES_NO_NOT_GIVEN
  MATCHING
  SHORT_ANSWER
  SENTENCE_COMPLETION
  SUMMARY_COMPLETION
  NOTE_COMPLETION
  TABLE_COMPLETION
  FLOW_CHART_COMPLETION
  DIAGRAM_LABEL_COMPLETION
}

enum SpeakingPart {
  PART_1
  PART_2
  PART_3
}

enum SpeakingSessionStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  EVALUATING
  EVALUATED
  FAILED
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique

  sessions  SpeakingSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Test {
  id          String       @id @default(cuid())
  title       String
  description String?
  type        TestType
  module      IELTSModule
  status      TestStatus   @default(DRAFT)

  sections    TestSection[]
  sessions    SpeakingSession[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([module, type])
}

model TestSection {
  id          String     @id @default(cuid())
  testId      String
  title       String
  description String?
  order       Int

  test        Test       @relation(fields: [testId], references: [id], onDelete: Cascade)
  questions   Question[]

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([testId, order])
}

model Question {
  id          String       @id @default(cuid())
  sectionId   String
  type        QuestionType
  question    String
  explanation String?
  order       Int
  points      Int          @default(1)

  section     TestSection  @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([sectionId, order])
}

model SpeakingSession {
  id          String                @id @default(cuid())
  userId      String
  testId      String?

  status      SpeakingSessionStatus @default(NOT_STARTED)

  startedAt   DateTime?
  completedAt DateTime?

  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  test        Test?                 @relation(fields: [testId], references: [id], onDelete: SetNull)

  turns       SpeakingTurn[]
  evaluation  SpeakingEvaluation?

  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([userId])
  @@index([userId, status])
}

model SpeakingTurn {
  id          String        @id @default(cuid())
  sessionId   String

  part        SpeakingPart
  order       Int

  question    String
  answer      String?
  audioUrl    String?

  startedAt   DateTime?
  completedAt DateTime?

  session     SpeakingSession @relation(fields: [sessionId],references: [id], onDelete: Cascade)

  @@unique([sessionId, order])
  @@index([sessionId, part])
}

model SpeakingEvaluation {
  id          String @id @default(cuid())
  sessionId   String @unique

  fluencyCoherence       Float
  lexicalResource        Float
  grammaticalAccuracy    Float
  pronunciation          Float
  overall                 Float

  summary                 String?
  strengths               Json?
  weaknesses              Json?
  recommendations         Json?

  evaluatedAt             DateTime @default(now())

  session                 SpeakingSession @relation(fields: [sessionId],references: [id],onDelete: Cascade)
}